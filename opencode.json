{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "dahl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Dahl",
      "options": {
        "baseURL": "https://inference.dahl.global/v1",
        "apiKey": "{env:DAHL_API_KEY}"
      },
      "models": {
        "MiniMaxAI/MiniMax-M2.7": {
          "name": "MiniMax M2.7"
        },
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash"
        }
      }
    }
  },
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "obsidian": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<2",
        "mcp-obsidian"
      ],
      "enabled": true,
      "env": {
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_HOST": "127.0.0.1",
        "OBSIDIAN_PORT": "27124"
      }
    }
  },
  "agent": {
    "web-search": {
      "model": "deepseek/deepseek-flash"
    },
    "web-search-modules/academic-papers": {
      "model": "deepseek/deepseek-flash"
    },
    "web-search-modules/chinese-tech": {
      "model": "deepseek/deepseek-flash"
    },
    "web-search-modules/general-web": {
      "model": "deepseek/deepseek-flash"
    },
    "web-search-modules/github-debug": {
      "model": "deepseek/deepseek-flash"
    },
    "web-search-modules/stackoverflow": {
      "model": "deepseek/deepseek-flash"
    }
  }
}
